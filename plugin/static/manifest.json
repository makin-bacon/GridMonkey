{
  "manifestVersion": 5,
  "id": "com.gridmonkey.indesign",
  "name": "GridMonkey",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.5.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "gridmonkeyPanel",
      "label": { "default": "GridMonkey" },
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 2000, "height": 4000 },
      "preferredDockedSize": { "width": 300, "height": 640 },
      "preferredFloatingSize": { "width": 320, "height": 680 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin"
  }
}
